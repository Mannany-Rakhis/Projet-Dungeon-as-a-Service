                  "type": "array",
                  "title": "Response List Heroes Heroes Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "Héros"
        ],
        "summary": "Create Hero",
        "description": "Crée un héros pour le joueur authentifié.",
        "operationId": "create_hero_heroes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeroCreate"
              }
            }
